# Copy this file to .env and fill in the values. PHP loads it automatically
# (config/database.php). Real environment variables override these values.

# Host port for the web app in Docker (`docker compose`). Ignored by local PHP.
APP_PORT=8080

# Database connection (local PHP and app container).
DB_HOST=127.0.0.1
DB_PORT=3306

# Docker only: host port to reach MariaDB from this machine (127.0.0.1 only).
# Change it if the port is already used; the app container always uses db:3306.
DB_PUBLISH_PORT=3307
DB_NAME=sparta
DB_USER=sparta
DB_PASSWORD=
